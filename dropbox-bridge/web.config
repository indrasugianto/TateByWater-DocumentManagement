<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS in-process hosting config for the TBCMS Dropbox Bridge.
  `dotnet publish` rewrites the <aspNetCore> processPath/arguments for the
  published layout, but preserves the <security> block below. The
  requestFiltering maxAllowedContentLength is SEPARATE from
  IISServerOptions.MaxRequestBodySize (Program.cs) and is the in-process knob
  that actually gates upload size — without it large uploads fail with HTTP
  404.13 BEFORE reaching the app (G32).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*"
           modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2147483648" />
      </requestFiltering>
    </security>
    <aspNetCore processPath="dotnet"
                arguments=".\TBCMSDropboxBridge.dll"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
</configuration>
